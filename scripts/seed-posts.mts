async function main() {
  for (const [i, post] of POSTS.entries()) {
    const category = post.categorySlug
      ? await prisma.partCategory.findUnique({ where: { slug: post.categorySlug } })
      : null;

    const publishedAt = new Date(Date.now() - (POSTS.length - i) * 5 * 864e5);

    await prisma.post.upsert({
      where: { slug: post.slug },
      create: {
        slug: post.slug,
        title: post.title,
        excerpt: post.excerpt,
        content: post.content,
        tag: post.tag,
        readMinutes: post.readMinutes,
        isFeatured: post.isFeatured ?? false,
        isPublished: true,
        publishedAt,
        categoryId: category?.id,
      },
      update: {
        title: post.title,
        excerpt: post.excerpt,
        content: post.content,
        tag: post.tag,
        readMinutes: post.readMinutes,
        isFeatured: post.isFeatured ?? false,
        categoryId: category?.id,
      },
    });
    console.log(`  ✓ ${post.title}`);
  }
  console.log(`\n${POSTS.length} مقاله ثبت شد`);
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(() => prisma.$disconnect());
